                      "search": {
                        "query": "@type:session @session.view.count:1 service:ringdog-frontend env:demo -@browser.name:HeadlessChrome"
                      },
                      "compute": {
                        "aggregation": "count"
                      }
                    },
                    {
                      "data_source": "rum",
                      "name": "s",
                      "search": {
                        "query": "@type:session service:ringdog-frontend env:demo -@browser.name:HeadlessChrome"
